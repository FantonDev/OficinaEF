
@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="clair-login-container">

    <div class="clair-login-card">

        <!-- PAINEL DA MARCA -->
        <div class="clair-brand-panel">

            <div class="clair-brand-logo">
                <span class="clair-logo-symbol">☾</span>
                <span>CLAIR DE LUNE</span>
            </div>

            <div class="clair-brand-content">

                <span class="clair-brand-subtitle">
                    FASHION & STYLE
                </span>

                <h2>
                    Vista a beleza
                    <br />
                    de ser você.
                </h2>

                <p>
                    Descubra uma nova forma de expressar sua personalidade
                    através da moda. Seu estilo merece brilhar.
                </p>

                <div class="clair-brand-decoration">
                    ✦ &nbsp; Elegância em cada detalhe
                </div>

            </div>

            <div class="clair-brand-footer">
                © @DateTime.Now.Year Clair de Lune. Todos os direitos reservados.
            </div>

        </div>

        <!-- ÁREA DE LOGIN -->
        <div class="clair-form-panel">

            <div class="clair-form-container">

                <div class="clair-mobile-logo">
                    <span>☾</span> CLAIR DE LUNE
                </div>

                <div class="clair-form-header">

                    <span class="clair-form-label">
                        SEJA BEM-VINDO(A)
                    </span>

                    <h1>Olá novamente!</h1>

                    <p>
                        Entre na sua conta para continuar
                        explorando nosso universo.
                    </p>

                </div>

                <form id="account" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="clair-validation-summary"
                         role="alert"></div>

                    <!-- EMAIL -->
                    <div class="clair-input-group">

                        <label asp-for="Input.Email">
                            E-mail
                        </label>

                        <input asp-for="Input.Email"
                               class="clair-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="seuemail@exemplo.com" />

                        <span asp-validation-for="Input.Email"
                              class="clair-validation-message"></span>

                    </div>

                    <!-- SENHA -->
                    <div class="clair-input-group">

                        <label asp-for="Input.Password">
                            Senha
                        </label>

                        <input asp-for="Input.Password"
                               class="clair-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Digite sua senha" />

                        <span asp-validation-for="Input.Password"
                              class="clair-validation-message"></span>

                    </div>

                    <!-- OPÇÕES -->
                    <div class="clair-form-options">

                        <label asp-for="Input.RememberMe"
                               class="clair-remember">

                            <input asp-for="Input.RememberMe" />

                            <span>Manter conectado</span>

                        </label>

                        <a id="forgot-password"
                           asp-page="./ForgotPassword"
                           class="clair-link">

                            Esqueceu a senha?

                        </a>

                    </div>

                    <!-- BOTÃO LOGIN -->
                    <button id="login-submit"
                            type="submit"
                            class="clair-login-button">

                        Entrar na minha conta

                    </button>

                    <!-- DIVISOR -->
                    <div class="clair-divider">
                        <span>OU</span>
                    </div>

                </form>

                <!-- LOGIN EXTERNO -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="clair-external-button"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Entrar usando @provider.DisplayName">

                                Continuar com @provider.DisplayName

                            </button>
                        }

                    </form>
                }

                <!-- CADASTRO -->
                <div class="clair-register">

                    <p>
                        Ainda não possui uma conta?
                    </p>

                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="clair-register-link">

                        Criar minha conta

                    </a>

                </div>

                <!-- REENVIO DE CONFIRMAÇÃO -->
                <div class="clair-resend">

                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation">

                        Reenviar confirmação de e-mail

                    </a>

                </div>

                <div class="clair-form-footer">
                    Feito com carinho para você. <span>✦</span>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
